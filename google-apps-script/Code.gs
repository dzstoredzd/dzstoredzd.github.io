var HEADERS=['lead_id','created_at','name','email','phone','shop_type','status','source','medium','campaign','sheet_sync_status'];
function setupLeadSheet(){var spreadsheet=SpreadsheetApp.getActiveSpreadsheet(),properties=PropertiesService.getScriptProperties(),secret=properties.getProperty('WEBHOOK_SECRET')||Utilities.getUuid()+Utilities.getUuid();properties.setProperties({SPREADSHEET_ID:spreadsheet.getId(),WEBHOOK_SECRET:secret});var sheet=spreadsheet.getSheetByName('Leads')||spreadsheet.insertSheet('Leads');sheet.setRightToLeft(false);if(sheet.getLastRow()===0)sheet.appendRow(HEADERS);sheet.setFrozenRows(1);sheet.getRange(1,1,1,HEADERS.length).setBackground('#142653').setFontColor('#ffffff').setFontWeight('bold');sheet.autoResizeColumns(1,HEADERS.length);return{spreadsheetId:spreadsheet.getId(),webhookSecret:secret}}
function doPost(event){try{var payload=JSON.parse(event.postData.contents||'{}'),properties=PropertiesService.getScriptProperties();if(!payload.secret||payload.secret!==properties.getProperty('WEBHOOK_SECRET'))return response({ok:false,error:'unauthorized'});var lead=payload.lead||{};if(!lead.id)return response({ok:false,error:'missing_lead_id'});var lock=LockService.getScriptLock();lock.waitLock(10000);try{var spreadsheet=SpreadsheetApp.openById(properties.getProperty('SPREADSHEET_ID')),sheet=spreadsheet.getSheetByName('Leads');if(!sheet)throw new Error('Leads sheet is missing');var lastRow=sheet.getLastRow();if(lastRow>1){var match=sheet.getRange(2,1,lastRow-1,1).createTextFinder(String(lead.id)).matchEntireCell(true).findNext();if(match)return response({ok:true,duplicate:true})}sheet.appendRow([lead.id||'',lead.created_at||'',lead.name||'',lead.email||'',lead.phone||'',lead.shop_type||'',lead.status||'new',lead.source||'',lead.medium||'',lead.campaign||'','synced']);return response({ok:true})}finally{lock.releaseLock()}}catch(error){return response({ok:false,error:String(error&&error.message||error)})}}
function response(body){return ContentService.createTextOutput(JSON.stringify(body)).setMimeType(ContentService.MimeType.JSON)}
